# Copy to .env.local for development, or set these in your host's environment settings.

# ---- Required in production -------------------------------------------------
# Signs login sessions. A long random string:   openssl rand -base64 48
AUTH_SECRET=
# Signs payment webhooks from the gateway to the store. A different long random string.
PAYMENT_WEBHOOK_SECRET=
# Public address of the site, no trailing slash (canonical links, sitemap, social previews).
SITE_URL=https://shop.example.com

# ---- Database ---------------------------------------------------------------
# SQLite file holding users, orders, payments, catalogue and stock. Created automatically on first start.
# Put it on a persistent disk or volume. (Docker image default: /data/alta.db)
DATABASE_PATH=./data/alta.db
# First owner account for a fresh production database. Used once, only when no owner exists. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 1 = also load the demo accounts and two months of sample orders. On by default in development, off in production.
SEED_DEMO_DATA=

# ---- Payments ---------------------------------------------------------------
# "demo" is the built-in sandbox gateway. It only accepts published test cards and moves no money.
PAYMENT_PROVIDER=demo
# A production build refuses sandbox payments unless you opt in. Set to 1 for a public DEMO deployment only.
# Leave unset on a real store, where checkout stays disabled until a live gateway adapter is installed.
ALLOW_DEMO_PAYMENTS=
# Taka per US dollar for the USD/BDT toggle. The rate is locked per checkout. Refresh it regularly.
BDT_PER_USD=122
